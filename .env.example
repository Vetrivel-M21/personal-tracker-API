# Copy to .env and fill in real values for local/dev use. In production
# these are set directly in docker-compose.yml / the host environment.

# postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://aura:aura@localhost:5432/aura?sslmode=disable

# 32+ random bytes, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret

# The domain the frontend is served from -- used for the Origin-header CSRF
# check on state-changing requests. In local dev this is typically
# localhost or 127.0.0.1.
PUBLIC_HOSTNAME=localhost

# Optional, defaults to 8080
PORT=8080

# Optional -- unset simply disables "Sign in with Google". Google Cloud
# Console -> APIs & Services -> Credentials -> OAuth client ID. Same value
# as frontend/.env's VITE_GOOGLE_CLIENT_ID (a Client ID, not a secret --
# verifying an ID token only needs this, not a Client Secret).
GOOGLE_CLIENT_ID=

# Required for username/password signup (email verification is mandatory --
# signup 500s with a clear message if these are unset). Point at either:
#  - Resend (resend.com, free tier): host smtp.resend.com, port 587,
#    username "resend", password = your Resend API key.
#  - Gmail with an App Password: host smtp.gmail.com, port 587, username =
#    your Gmail address, password = a generated App Password (not your
#    normal Google password -- Account > Security > App Passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The "From" address verification emails are sent as.
SMTP_FROM=
