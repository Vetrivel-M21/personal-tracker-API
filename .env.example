# Copy to .env and fill in real values for local/dev use. In production
# these are set directly in docker-compose.yml / the host environment.

# postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://aura:aura@localhost:5432/aura?sslmode=disable

# 32+ random bytes, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret

# The domain the frontend is served from -- used for the Origin-header CSRF
# check on state-changing requests. In local dev this is typically
# localhost or 127.0.0.1.
PUBLIC_HOSTNAME=localhost

# Optional, defaults to 8080
PORT=8080
